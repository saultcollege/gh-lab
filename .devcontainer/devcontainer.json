{
  "name": "gh-lab",

  "image": "mcr.microsoft.com/devcontainers/python:3.14-bookworm",

  "features": {
    "ghcr.io/devcontainer-community/devcontainer-features/astral.sh-uv:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "postCreateCommand": "uv sync",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  },

  "remoteUser": "vscode"
}